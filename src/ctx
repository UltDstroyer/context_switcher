#!/usr/bin/env bash
set -euo pipefail

CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/ctx"
PROJECT_DIR="$CONFIG_ROOT/projects"
ARCHIVE_DIR="$CONFIG_ROOT/archived"
STATE_DIR="$CONFIG_ROOT/state"
CURRENT_FILE="$STATE_DIR/current"
HOOK_DIR="$CONFIG_ROOT/hooks"

mkdir -p "$PROJECT_DIR" "$ARCHIVE_DIR" "$STATE_DIR"

# Serialize lifecycle changes, including potentially slow service shutdowns.
exec 9>"$STATE_DIR/lifecycle.lock"
flock -x 9

die() {
  printf 'ctx: %s\n' "$*" >&2
  exit 1
}

slugify() {
  local value="$1"
  value="${value,,}"
  value="$(printf '%s' "$value" | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
  [[ -n "$value" ]] || value="context"
  printf '%s\n' "$value"
}

unique_slug() {
  local base="$1" candidate="$1" n=2
  while [[ -e "$PROJECT_DIR/$candidate.conf" || -e "$ARCHIVE_DIR/$candidate.conf" ]]; do
    candidate="${base}-$n"
    ((n++))
  done
  printf '%s\n' "$candidate"
}

conf_path() {
  local slug="$1"
  if [[ -f "$PROJECT_DIR/$slug.conf" ]]; then
    printf '%s\n' "$PROJECT_DIR/$slug.conf"
  elif [[ -f "$ARCHIVE_DIR/$slug.conf" ]]; then
    printf '%s\n' "$ARCHIVE_DIR/$slug.conf"
  else
    return 1
  fi
}

read_name() {
  local slug="$1" file
  file="$(conf_path "$slug")" || return 1
  sed -n 's/^name=//p' "$file" | head -n1
}

current_context() {
  [[ -f "$CURRENT_FILE" ]] && cat "$CURRENT_FILE"
}

ensure_daemon() {
  if ctxdctl ping >/dev/null 2>&1; then
    return 0
  fi

  if ! command -v ctxd >/dev/null 2>&1; then
    die "ctxd is not installed or not in PATH"
  fi

  nohup ctxd 9>&- >/dev/null 2>&1 &
  for _ in {1..30}; do
    sleep 0.1
    if ctxdctl ping >/dev/null 2>&1; then
      return 0
    fi
  done
  die "could not start context monitoring daemon"
}

start_monitoring() {
  local slug="$1"
  ensure_daemon || return 1
  ctxdctl start "$slug" >/dev/null
}

checkpoint_context() {
  local slug="$1"
  ensure_daemon || return 1
  ctxdctl checkpoint "$slug" >/dev/null
}

stop_monitoring() {
  if ctxdctl ping >/dev/null 2>&1; then
    ctxdctl stop >/dev/null || return 1
  fi
}

validate_slug() {
  [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid context slug: $1"
}

run_hook() {
  local slug="$1" event="$2" hook="$HOOK_DIR/$1/$2"
  [[ -e "$hook" ]] || return 0
  [[ -f "$hook" && -x "$hook" ]] || {
    printf 'ctx: hook must be an executable file: %s\n' "$hook" >&2
    return 1
  }
  CTX_CONTEXT="$slug" CTX_EVENT="$event" CTX_CONFIG_ROOT="$CONFIG_ROOT" \
    "$hook" 9>&- || {
      printf 'ctx: %s hook failed for %s\n' "$event" "$slug" >&2
      return 1
    }
}

leave_context() {
  local slug="$1"
  checkpoint_context "$slug" || return 1
  # Keep the old context active if its shutdown fails, so leaving can be retried.
  run_hook "$slug" leave || return 1
  stop_monitoring || return 1
  rm -f "$CURRENT_FILE"
}

switch_context() {
  local slug="$1" old
  validate_slug "$slug"
  [[ -f "$PROJECT_DIR/$slug.conf" ]] || die "unknown or archived context: $slug"

  old="$(current_context || true)"
  if [[ "$old" == "$slug" ]]; then
    printf 'Already in %s\n' "$slug"
    return 0
  fi

  # Check the daemon before shutting down the previous context.
  ensure_daemon
  if [[ -n "$old" ]]; then
    leave_context "$old" || die "could not leave $old; context switch cancelled"
  fi

  if ! start_monitoring "$slug"; then
    stop_monitoring
    die "could not start context monitoring; no context is active"
  fi
  if ! run_hook "$slug" enter; then
    # A hook may have partially started a service before reporting failure.
    if ! run_hook "$slug" leave; then
      printf '%s\n' "$slug" > "$CURRENT_FILE"
      die "enter and cleanup failed for $slug; context retained so ctx exit can retry"
    fi
    stop_monitoring
    die "enter hook failed for $slug; no context is active"
  fi
  printf '%s\n' "$slug" > "$CURRENT_FILE"
  printf 'Switched to %s\n' "$slug"
}

cmd_service() {
  local slug="${1:-}" unit="${2:-}" dir event action
  [[ -n "$slug" && -n "$unit" && "$#" -eq 2 ]] || die "usage: ctx service <context> <user-service>"
  validate_slug "$slug"
  [[ -f "$PROJECT_DIR/$slug.conf" ]] || die "unknown or archived context: $slug"
  [[ "$unit" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.@:-]*\.service$ ]] || die "expected a systemd .service unit name"
  [[ "$(current_context || true)" != "$slug" ]] || die "exit $slug before configuring its service"
  dir="$HOOK_DIR/$slug"
  [[ ! -e "$dir/enter" && ! -e "$dir/leave" ]] || die "hooks already exist for $slug; edit them instead"
  mkdir -p "$dir"
  for event in enter leave; do
    action=start
    [[ "$event" == leave ]] && action=stop
    {
      printf '#!/usr/bin/env bash\nset -euo pipefail\n'
      printf 'exec systemctl --user %s -- %q\n' "$action" "$unit"
    } > "$dir/$event"
    chmod 700 "$dir/$event"
  done
  printf 'Attached %s to %s. It will start on entry and stop on leave.\n' "$unit" "$slug"
}


# Extension API v1: the core never knows a plugin's internal commands.
extension_dispatch() {
  local extension="$1" executable active
  shift
  [[ "$extension" =~ ^[a-z][a-z0-9-]{0,47}$ ]] ||
    die "invalid extension name: $extension"

  executable="ctx-ext-$extension"
  command -v "$executable" >/dev/null 2>&1 ||
    die "extension '$extension' is not installed (expected $executable in PATH)"

  active="$(current_context || true)"
  if [[ -n "$active" ]]; then
    validate_slug "$active"
    [[ -f "$PROJECT_DIR/$active.conf" ]] ||
      die "active context has no configuration: $active"
  fi

  # No extra privilege or automatic lifecycle operation is granted.
  # Release lock before potentially lengthy extension execution.
  flock -u 9
  CTX_EXTENSION_API_VERSION=1 CTX_CONTEXT="$active" \
    CTX_CONFIG_ROOT="$CONFIG_ROOT" exec "$executable" "$@"
}

cmd_extensions() {
  local dir path name
  local -a dirs=()
  local -A discovered=()
  IFS=: read -r -a dirs <<< "$PATH"
  for dir in "${dirs[@]}"; do
    [[ -n "$dir" && -d "$dir" ]] || continue
    for path in "$dir"/ctx-ext-*; do
      [[ -f "$path" && -x "$path" ]] || continue
      name="${path##*/}"
      name="${name#ctx-ext-}"
      [[ "$name" =~ ^[a-z][a-z0-9-]{0,47}$ ]] || continue
      discovered["$name"]=1
    done
  done
  if [[ "${#discovered[@]}" -eq 0 ]]; then
    printf 'No ctx extensions installed.\n'
    return
  fi
  printf '%s\n' "${!discovered[@]}" | sort
}

cmd_new() {
  local name="${*:-}"
  if [[ -z "$name" ]]; then
    read -r -p "Context name: " name
  fi
  [[ -n "${name//[[:space:]]/}" ]] || die "context name cannot be empty"

  local slug
  slug="$(unique_slug "$(slugify "$name")")"
  {
    printf 'name=%s\n' "$name"
    printf 'created_at=%s\n' "$(date --iso-8601=seconds)"
  } > "$PROJECT_DIR/$slug.conf"

  switch_context "$slug"
}

cmd_list() {
  local mode="${1:-active}"
  local dirs=()
  case "$mode" in
    active) dirs=("$PROJECT_DIR") ;;
    --archived|archived) dirs=("$ARCHIVE_DIR") ;;
    --all|all) dirs=("$PROJECT_DIR" "$ARCHIVE_DIR") ;;
    *) die "usage: ctx list [--archived|--all]" ;;
  esac

  local current file slug name status found=0
  current="$(current_context || true)"

  for dir in "${dirs[@]}"; do
    shopt -s nullglob
    for file in "$dir"/*.conf; do
      found=1
      slug="$(basename "$file" .conf)"
      name="$(sed -n 's/^name=//p' "$file" | head -n1)"
      status=""
      [[ "$dir" == "$ARCHIVE_DIR" ]] && status=" [archived]"
      [[ "$slug" == "$current" ]] && status=" [current]"
      printf '%-24s %s%s\n' "$slug" "$name" "$status"
    done
    shopt -u nullglob
  done

  [[ "$found" -eq 1 ]] || printf 'No contexts.\n'
}

cmd_current() {
  local slug
  slug="$(current_context || true)"
  if [[ -z "$slug" ]]; then
    printf 'No active context.\n'
  else
    printf '%s\n' "$slug"
  fi
}

cmd_show() {
  local slug="${1:-$(current_context || true)}"
  [[ -n "$slug" ]] || die "no context specified and no context is active"
  validate_slug "$slug"
  local file
  file="$(conf_path "$slug")" || die "unknown context: $slug"
  cat "$file"
  printf 'slug=%s\n' "$slug"
  printf 'snapshot=%s/%s/snapshot.json\n' "$STATE_DIR" "$slug"
}

cmd_edit() {
  local slug="${1:-$(current_context || true)}"
  [[ -n "$slug" ]] || die "no context specified and no context is active"
  validate_slug "$slug"
  local file editor
  file="$(conf_path "$slug")" || die "unknown context: $slug"
  editor="${EDITOR:-vi}"
  "$editor" "$file"
}

cmd_exit() {
  local slug
  slug="$(current_context || true)"
  if [[ -z "$slug" ]]; then
    stop_monitoring
    printf 'No active context.\n'
    return 0
  fi

  leave_context "$slug" || die "could not leave $slug; context remains active"
  printf 'Exited %s\n' "$slug"
}

cmd_delete() {
  local slug="${1:-}"
  [[ -n "$slug" ]] || die "usage: ctx delete <context>"
  validate_slug "$slug"
  local file current
  file="$(conf_path "$slug")" || die "unknown context: $slug"
  current="$(current_context || true)"

  if [[ "$current" == "$slug" ]]; then
    leave_context "$slug" || die "could not leave $slug; context remains active"
  fi

  rm -f "$file"
  rm -rf "$STATE_DIR/$slug" "$HOOK_DIR/$slug"
  printf 'Deleted %s\n' "$slug"
}

cmd_archive() {
  local slug="${1:-}"
  [[ -n "$slug" ]] || die "usage: ctx archive <context>"
  validate_slug "$slug"
  [[ -f "$PROJECT_DIR/$slug.conf" ]] || die "unknown active context: $slug"

  local current
  current="$(current_context || true)"
  if [[ "$current" == "$slug" ]]; then
    leave_context "$slug" || die "could not leave $slug; context remains active"
  fi

  mv "$PROJECT_DIR/$slug.conf" "$ARCHIVE_DIR/$slug.conf"
  printf 'Archived %s\n' "$slug"
}

cmd_unarchive() {
  local slug="${1:-}"
  [[ -n "$slug" ]] || die "usage: ctx unarchive <context>"
  validate_slug "$slug"
  [[ -f "$ARCHIVE_DIR/$slug.conf" ]] || die "unknown archived context: $slug"
  [[ ! -e "$PROJECT_DIR/$slug.conf" ]] || die "active context already exists: $slug"

  mv "$ARCHIVE_DIR/$slug.conf" "$PROJECT_DIR/$slug.conf"
  printf 'Unarchived %s\n' "$slug"
}

usage() {
  cat <<'EOF'
Usage:
  ctx new [name]
  ctx list [--archived|--all]
  ctx current
  ctx show [context]
  ctx edit [context]
  ctx switch <context>
  ctx exit
  ctx service <context> <user-service>
  ctx extensions                        List installed extensions
  ctx <extension> [args...]             Run an installed ctx-ext-<extension>
  ctx delete <context>
  ctx archive <context>
  ctx unarchive <context>
EOF
}

case "${1:-}" in
  new)
    shift
    cmd_new "$@"
    ;;
  list)
    shift
    cmd_list "${1:-active}"
    ;;
  current)
    cmd_current
    ;;
  show)
    shift
    cmd_show "${1:-}"
    ;;
  edit)
    shift
    cmd_edit "${1:-}"
    ;;
  switch|use)
    [[ -n "${2:-}" ]] || die "usage: ctx switch <context>"
    switch_context "$2"
    ;;
  service)
    shift
    cmd_service "$@"
    ;;
  extensions)
    cmd_extensions
    ;;
  exit|leave)
    cmd_exit
    ;;
  delete|rm)
    cmd_delete "${2:-}"
    ;;
  archive)
    cmd_archive "${2:-}"
    ;;
  unarchive)
    cmd_unarchive "${2:-}"
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    extension="$1"
    shift
    extension_dispatch "$extension" "$@"
    ;;
esac
